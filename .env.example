# Local env files (gitignored). CI does NOT use these — it injects the
# VITE_FIREBASE_*(_DEV) GitHub secrets directly in .github/workflows/deploy.yml.
#
# Create two files from this template:
#   .env.development  → dev Firebase project (fairshare-split-dev)
#                       loaded by `npm run dev` and dev-mode builds.
#                       Add VITE_BUILD_ENV=dev to show the DEV badge.
#   .env.production   → prod Firebase project (fairshare-4c9a2)
#                       loaded by `vite build` (e.g. `make rollback-prod`).
#
# Firebase web config is shipped to the client and is not secret; these
# files are gitignored to keep the repo clean, not for security.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth web client id, for the "Back up to Google Sheets" feature.
# One per Firebase/GCP project (they're separate projects, so a sheet created
# against dev is invisible to prod and vice versa). Requires the Sheets API and
# Drive API enabled on that project, and the app's origins registered as
# Authorized JavaScript origins on the client.
# Leave it unset and the backup feature hides itself entirely.
# VITE_GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com

# Public Web Push (VAPID) key, for push notifications. Firebase console →
# Project settings → Cloud Messaging → Web configuration → Web Push
# certificates → Generate key pair. One per project; dev and prod keys are
# NOT interchangeable — a token minted against the wrong one silently
# receives nothing. Leave it unset and push hides itself entirely.
# VITE_FIREBASE_VAPID_KEY=

# dev only: shows the DEV badge in the header
# VITE_BUILD_ENV=dev
# Optional: comma-separated email whitelist (when set, only these users can sign in)
# VITE_ALLOWED_EMAILS=alice@gmail.com,bob@gmail.com

# Sentry crash reporting (optional). The DSN is a public client key — safe in
# the bundle. Unset = the feature is entirely off. One project serves prod and
# dev; the environment tag tells them apart. SENTRY_AUTH_TOKEN/ORG/PROJECT are
# CI-only (source-map upload) and never belong in local env files.
# VITE_SENTRY_DSN=
