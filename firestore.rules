rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — anyone authed can read, only the owner can write
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Trips — any authed user can read (needed for invite code lookups
    // and email invite queries) and create (with no special gating)
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // Any authed user can update trips (join via invite code/email,
      // add invitedEmails, update lastRates, etc.)
      // Real data protection is on the expenses subcollection (member-only)
      allow update: if request.auth != null;

      // Expenses — only trip members can read/write
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
      }
    }

    // Legacy allowedUsers collection — no longer used but kept readable
    // so existing data doesn't cause errors
    match /allowedUsers/{email} {
      allow read: if request.auth != null;
    }
  }
}
