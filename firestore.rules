rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email));
    }

    match /allowedUsers/{email} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isAllowedUser();
    }

    match /users/{uid} {
      allow read: if request.auth != null && isAllowedUser();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /trips/{tripId} {
      allow read: if request.auth != null
        && isAllowedUser()
        && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null && isAllowedUser();

      allow update: if request.auth != null
        && isAllowedUser()
        && request.auth.uid in resource.data.memberUids;

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
          && isAllowedUser()
          && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
      }
    }

    // Allow reading trips by invite code (for joining)
    match /trips/{tripId} {
      allow read: if request.auth != null && isAllowedUser();
    }
  }
}
